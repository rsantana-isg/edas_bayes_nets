%!PS-Adobe-2.0 EPSF-2.0
%%Title: Logo ENSL
%%Creator: Eric Bainville & Jean-Christophe Dubacq
%%CreationDate: Fri Jan 30 14:11:58 MET 1998
%%For: Laboratoire de l'Informatique du Parallelisme
%Magnification: 1.00
%%Orientation: Portrait
%%BoundingBox: 0 0 136 60
%%Pages: 0
%%BeginSetup
%%EndSetup
%%EndComments
% Logo ENS Lyon
% EB Nov 91
% Tous droits abandonnes
% Boite englobante : (0,0) - (136,60)
% Mode : noir et blanc

% IMPORTANT : ces declarations sont a inclure dans un fichier PostScript
% ---------   le dessin d'un logo se fait en (0,0) dans le ref. courant en
%             appelant la macro ensl_logo

/ensl_para_sup { dup 272 sub mul 880.76 div neg } def
/ensl_para_inf { dup 266.5 sub exch 5.5 sub mul 1098.72 div neg } def
/ensl_para_col { 136 div dup mul 0.67 mul } def
/ensl_logo {
newpath 107.75  0.00 moveto 112.75  0.00 lineto 112.75 30.00 lineto 107.75 30.00 lineto 0.5 setgray fill
newpath 101.00  0.00 moveto 106.00  0.00 lineto 106.00 37.00 lineto 101.00 37.00 lineto 0.5 setgray fill
newpath 94.25  0.00 moveto 99.25  0.00 lineto 99.25 60.00 lineto 94.25 60.00 lineto 0.5 setgray fill
newpath 87.50  0.00 moveto 92.50  0.00 lineto 92.50 60.00 lineto 87.50 60.00 lineto 0.5 setgray fill
newpath 80.75  0.00 moveto 85.75  0.00 lineto 85.75 60.00 lineto 80.75 60.00 lineto 0.5 setgray fill
newpath 74.00 20.00 moveto 79.00 15.00 lineto 79.00 44.00 lineto 74.00 44.00 lineto 0.5 setgray fill
newpath 67.25 20.00 moveto 72.25 20.00 lineto 72.25 44.00 lineto 67.25 44.00 lineto 0.5 setgray fill
newpath 0.0 0.0 moveto
0.0 2.0 136.0 { dup ensl_para_sup lineto } for
136.0 -2.25 5.5 { dup ensl_para_inf lineto } for
closepath
0 setgray fill
newpath 60.50 20.00 moveto 65.50 20.00 lineto 65.50 44.00 lineto 60.50 44.00 lineto 0.5 setgray fill
newpath 53.75 15.00 moveto 58.75 20.00 lineto 58.75 44.00 lineto 53.75 44.00 lineto 0.5 setgray fill
newpath 47.00  0.00 moveto 52.00  0.00 lineto 52.00 60.00 lineto 47.00 60.00 lineto 0.5 setgray fill
newpath 40.25  0.00 moveto 45.25  0.00 lineto 45.25 60.00 lineto 40.25 60.00 lineto 0.5 setgray fill
newpath 33.50  0.00 moveto 38.50  0.00 lineto 38.50 60.00 lineto 33.50 60.00 lineto 0.5 setgray fill
newpath 26.75  0.00 moveto 31.75  0.00 lineto 31.75 37.00 lineto 26.75 37.00 lineto 0.5 setgray fill
newpath 20.00  0.00 moveto 25.00  0.00 lineto 25.00 30.00 lineto 20.00 30.00 lineto 0.5 setgray fill
} def
% Fin de la declaration de ensl_logo
0 0 moveto ensl_logo

